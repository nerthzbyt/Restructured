# Copiar a .env: cp .env.example .env
#
# MODO PRINCIPAL (recomendado):
#   python NerT_AI_PRO/main.py run --host 127.0.0.1 --port 8787
#   UI: http://127.0.0.1:8787  |  API: http://127.0.0.1:8787/api
#
# NO correr Nertzh.py (8081) y NerT AI PRO (8787) simultáneamente.
#
# Todas las claves del motor viven en src/settings.py (SETTINGS). Este archivo se
# regenera con:  python src/settings.py --env-example
# Cualquier clave se puede cambiar en caliente: POST /api/config/update {"CLAVE": valor}
# Overrides por símbolo: SYMBOL_OVERRIDES_JSON={"XRPUSDT": {"RISK_FACTOR": 0.02}}

# ===== agente NerT_AI_PRO (fuera del registro del motor) =====
LLM_BACKEND=qwen_desktop
LLM_MODEL=qwen-plus-latest
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120

# ===== exchange =====
# API key de Bybit.
BYBIT_API_KEY=
# API secret de Bybit.
BYBIT_API_SECRET=
# Entorno Bybit. [mainnet | demo | testnet]
BYBIT_ENV=mainnet
# Categoría de producto Bybit. El ciclo de ejecución actual implementa spot. [spot]
BYBIT_CATEGORY=spot
# Override REST privado (vacío = según BYBIT_ENV).
BYBIT_REST_URL=
# Override REST público de mercado.
BYBIT_PUBLIC_REST_URL=
# Override WebSocket público.
BYBIT_WS_PUBLIC_URL=
# recv_window de firma (ms). [1000 .. 60000]
BYBIT_RECV_WINDOW=5000
# Timeout HTTP REST. [1.0 .. 120.0]
BYBIT_HTTP_TIMEOUT_S=15.0
# Reintentos HTTP (429/5xx/red). [0 .. 10]
BYBIT_HTTP_MAX_RETRIES=3
# Envía órdenes reales al exchange.
LIVE_TRADING_ENABLED=false
# Moneda de cotización/cuenta para balance.
QUOTE_COIN=USDT
# Tipo de cuenta preferido para wallet-balance.
ACCOUNT_TYPE=UNIFIED
# Tipos de cuenta a probar en orden si el preferido no devuelve balance.
ACCOUNT_TYPE_FALLBACKS=UNIFIED,SPOT
# Prefijo de orderLinkId que identifica órdenes propias del bot.
ORDER_LINK_PREFIX=nertzh-
# Deriva de reloj máxima tolerada en preflight. [0.5 .. 120.0]
CLOCK_DRIFT_MAX_S=10.0
# Cache de reglas de instrumento (tick/lot). [10.0 .. 86400.0]
INSTRUMENT_RULES_TTL_S=3600.0

# ===== market =====
# Símbolos a operar separados por coma (cualquier par válido del exchange).
SYMBOL=BTCUSDT
# Intervalo de velas. [1m | 3m | 5m | 15m | 30m | 1h | 2h | 4h | 6h | 12h | 1d | 1w | 1M]
TIMEFRAME=1m
# Niveles de libro usados en métricas. [1 .. 200]
ORDERBOOK_DEPTH=50
# Velas mantenidas en memoria por símbolo. [21 .. 1000]
CANDLE_BUFFER_SIZE=50
# Trades públicos en memoria por símbolo. [10 .. 20000]
RECENT_TRADES_BUFFER=500
# Trades públicos pasados al cálculo de métricas. [3 .. 5000]
RECENT_TRADES_METRICS_N=50
# Espera antes de reconectar el WebSocket. [0.5 .. 300.0]
WS_RECONNECT_DELAY_S=5.0
# Reintentos de carga REST inicial. [1 .. 20]
INITIAL_FETCH_ATTEMPTS=3

# ===== orders =====
# Tipo de orden de entrada. [Limit | Market]
ORDER_TYPE=Limit
# Time in force de órdenes Limit. [GTC | IOC | FOK | PostOnly]
TIME_IN_FORCE=GTC
# Órdenes simultáneas en vuelo (todas las monedas). [1 .. 1000]
MAX_CONCURRENT_ORDERS=20
# Permite varios trades abiertos por símbolo.
ALLOW_MULTIPLE_ACTIVE_TRADES=true
# Pausa mínima entre trades de un símbolo. [0.0 .. 86400.0]
TRADE_COOLDOWN_S=0.0
# Ignora el cooldown con señal fuerte.
COOLDOWN_BYPASS_STRONG_SIGNAL=true
# Múltiplo del umbral que se considera señal fuerte. [1.0 .. 10.0]
COOLDOWN_BYPASS_MULT=1.25
# Intervalo de sincronización de órdenes. [0.5 .. 300.0]
ORDERS_SYNC_INTERVAL_S=5.0
# Edad a partir de la cual se re-precia una Limit. [0.5 .. 3600.0]
ORDERS_SYNC_UPDATE_AFTER_S=5.0
# Edad a partir de la cual se cancela una orden abierta. [1.0 .. 86400.0]
ORDERS_SYNC_TIMEOUT_S=15.0
# Órdenes por consulta de sync. [1 .. 50000]
ORDERS_SYNC_LIMIT=100
# Cancela órdenes tpsl nativas más viejas que esto (0=off). [0.0 .. 86400.0]
TPSL_CANCEL_AFTER_S=90.0
# Reintentos al colocar orden (rate limit / banda de precio). [1 .. 20]
MAX_CHASE_ATTEMPTS=3
# Base de backoff entre reintentos de orden (s). [0.0 .. 60.0]
CHASE_INTERVAL=2.0

# ===== risk =====
# Capital simulado cuando no hay wallet real. [0.0 .. inf]
CAPITAL_USDT=2000.0
# Fracción del capital arriesgada por trade. [0.0 .. 1.0]
RISK_FACTOR=0.01
# Tope de nocional por trade como fracción del capital. [0.0 .. 1.0]
MAX_POSITION_NOTIONAL_PCT=0.1
# Tope opcional en unidades base (0 = sin tope; usar SYMBOL_OVERRIDES_JSON por par). [0.0 .. inf]
MAX_TRADE_SIZE=0.0
# Mínimo opcional en unidades base (0 = mínimo del exchange). [0.0 .. inf]
MIN_TRADE_SIZE=0.0
# Margen sobre el nocional mínimo del exchange. [1.0 .. 5.0]
MIN_NOTIONAL_BUFFER=1.1
# Volatilidad usada si la medida es 0/ inválida. [1e-06 .. 1.0]
VOLATILITY_FALLBACK=0.01
# Comisión por lado (fracción del nocional). [0.0 .. 0.1]
FEE_RATE=0.002
# Multiplicador de volatilidad para TP. [0.0 .. inf]
TP_PERCENTAGE=1.5
# Multiplicador de volatilidad para SL. [0.0 .. inf]
SL_PERCENTAGE=0.5
# Trades máximos antes de parar (0 = ilimitado). [0 .. inf]
MAX_ITERATIONS=0
# Horizonte para cerrar el resultado de trades simulados. [1.0 .. 86400.0]
OUTCOME_HORIZON_S=15.0

# ===== signal =====
# Umbral de compra del combined. [-100.0 .. 100.0]
COMBINED_BUY_THRESHOLD=4.5
# Umbral de venta del combined. [-100.0 .. 100.0]
COMBINED_SELL_THRESHOLD=-4.5
# Banda |combined| sin operar. [0.0 .. 100.0]
COMBINED_HOLD_BAND=3.0
# Umbral EGM (legacy, calibración).
EGM_BUY_THRESHOLD=0.02
# Umbral EGM (legacy, calibración).
EGM_SELL_THRESHOLD=-0.02
# Umbral PIO (legacy).
PIO_THRESHOLD=0.0
# Spread medio de referencia para el gate de ejecución. [0.01 .. 500.0]
AVG_SPREAD_BPS=1.5
# Pesos por defecto del combined (pio, egm, ild, rol, ogm, mom, tfi, scale).
COMBINED_WEIGHTS_JSON={"pio":0.25,"egm":0.3,"ild":-0.15,"rol":0.1,"ogm":0.05,"mom":0.16,"tfi":0.25,"scale":10.0}
# Overrides de parámetros del motor de señal (ver signal_engine.SignalParams).
SIGNAL_PARAMS_JSON=
# Fórmulas TSM derivadas.
FORMULAS_JSON={"basis":"(mark_price - index_price) / (index_price + 1e-12)","obi":"(bid_notional_sum_k - ask_notional_sum_k) / (bid_notional_sum_k + ask_notional_sum_k + 1e-12)","tfi":"(taker_buy_qty - taker_sell_qty) / (taker_buy_qty + taker_sell_qty + 1e-12)","spread_rel":"(best_ask - best_bid) / (mid_price + 1e-12)","microprice_offset":"(microprice - mid_price) / (mid_price + 1e-12)","rvol":"RecentTrades:rvol","spread_bps":"SpreadRel * 10000","microprice_offset_bps":"((MicroPrice - MidPrice) / (MidPrice + 1e-12)) * 10000"}
# Legacy. [0.0 .. 100.0]
RSI_UPPER_THRESHOLD=80.0
# Legacy. [0.0 .. 100.0]
RSI_LOWER_THRESHOLD=20.0
# Legacy. [0.0 .. 0.1]
PRICE_SHIFT_FACTOR=0.003
# Legacy. [0.0 .. inf]
VOLUME_THRESHOLD=1.0

# ===== metrics =====
# Decaimiento exponencial por distancia al mid (PIO). [0.0 .. inf]
ORDERBOOK_LAMBDA=0.03
# Banda relativa al mid usada en el libro. [0.0 .. 0.25]
ORDERBOOK_PCT_BAND=0.015
# Movimiento objetivo para ILD. [0.0001 .. 0.05]
ILD_TARGET_MOVE=0.002
# Ventana de historia para z-scores. [1.0 .. 1440.0]
METRICS_WINDOW_MINUTES=15.0
# Decisiones recientes mantenidas por símbolo. [10 .. 100000]
METRICS_WINDOW_BUFFER=2500
# Recalcular métricas en vivo cada N s. [1.0 .. 3600.0]
METRICS_LIVE_REFRESH_S=5.0
# Snapshot persistido de métricas cada N s. [1.0 .. 3600.0]
METRICS_SNAPSHOT_INTERVAL_S=55.0
# Separación mínima entre snapshots. [0.0 .. 3600.0]
METRICS_SNAPSHOT_DEDUP_S=3.0
# Separación mínima de eventos metrics en results.json. [0.0 .. 86400.0]
METRICS_RESULTS_EVENT_MIN_S=0.0

# ===== automation =====
# Periodo del loop de soporte. [0.25 .. 30.0]
SUPPORT_LOOP_INTERVAL_S=1.0
# Refresco periódico del balance. [1.0 .. 3600.0]
BALANCE_SYNC_INTERVAL_S=60.0
# Refresco tras operar (balance sucio). [0.0 .. 600.0]
BALANCE_DIRTY_SYNC_S=2.0
# Activa AUTO_AGENT tras SECONDARY_SYSTEMS_DELAY_S de arranque.
AUTO_ENABLE_SECONDARY_SYSTEMS=false
# Retardo para auto-activar sistemas secundarios. [0.0 .. 3600.0]
SECONDARY_SYSTEMS_DELAY_S=20.0
# Agente interno (relajar umbrales, reentrenar ML).
AUTO_AGENT_ENABLED=false
# Intervalo de reentreno ML. [1.0 .. 1440.0]
AUTO_AGENT_TRAIN_INTERVAL_MIN=5.0
# Separación mínima entre ticks del agente. [0.0 .. 600.0]
AGENT_TICK_MIN_S=0.5
# Separación mínima entre relajaciones. [1.0 .. 86400.0]
AGENT_RELAX_INTERVAL_S=120.0
# Decisiones mínimas en ventana para relajar. [1 .. 100000]
AGENT_RELAX_MIN_SNAPSHOTS=80
# Ratio de hold que dispara la relajación. [0.0 .. 1.0]
AGENT_RELAX_HOLD_RATIO=0.92
# Segundos sin trades para permitir relajar. [0.0 .. 86400.0]
AGENT_RELAX_IDLE_S=600.0
# Factor multiplicativo de relajación. [0.1 .. 1.0]
AGENT_RELAX_FACTOR=0.85
# Decisiones máximas analizadas por tick. [1 .. 100000]
AGENT_DECISIONS_MAX=250
# Auto-calibración de umbrales con trades finales.
AUTO_TUNE_THRESHOLDS=false
# Periodo de auto-calibración. [1.0 .. 86400.0]
AUTO_TUNE_INTERVAL_S=60.0
# Trades finales mínimos para calibrar. [1 .. 100000]
AUTO_TUNE_MIN_TRADES=20
# Trades usados por calibración. [1 .. 1000000]
AUTO_TUNE_SAMPLE=200
# Mezcla hacia el objetivo por calibración. [0.0 .. 1.0]
AUTO_TUNE_ALPHA=0.1
# Escribe umbrales optimizados en .env.
PERSIST_THRESHOLDS_TO_ENV=false
# Borra BD y results.json al arrancar.
FULL_RESET_ON_BOOT=false
# Auto-commit de resultados (desarrollo).
AUTO_GIT_COMMIT=false

# ===== hft =====
# Arranque/parada automática de loops HFT.
AUTO_HFT_ENABLED=false
# Evaluación del auto-HFT cada N s. [0.25 .. 3600.0]
AUTO_HFT_TICK_S=2.0
# Ventana de decisiones analizada. [10.0 .. 86400.0]
AUTO_HFT_WINDOW_S=60.0
# Decisiones mínimas para actuar. [5 .. 100000]
AUTO_HFT_MIN_SNAPSHOTS=30
# Ratio buy/sell que arranca HFT. [0.0 .. 1.0]
AUTO_HFT_START_RATIO=0.35
# Ratio buy/sell que detiene HFT. [0.0 .. 1.0]
AUTO_HFT_STOP_RATIO=0.15
# |combined| medio mínimo para HFT. [0.0 .. inf]
AUTO_HFT_COMBINED_ABS_THRESHOLD=10.0
# Periodo de ciclo HFT. [0 .. 60000]
AUTO_HFT_INTERVAL_MS=250
# HFT solo recolecta (no opera).
AUTO_HFT_COLLECT_ONLY=true
# Separación mínima entre cambios de estado HFT. [5.0 .. 86400.0]
AUTO_HFT_COOLDOWN_S=60.0

# ===== tpsl =====
# Gestión de TP/SL virtual (spot).
AUTO_TPSL_ENABLED=true
# Periodo del gestor TP/SL. [0.25 .. 60.0]
AUTO_TPSL_INTERVAL_S=3.0
# Ticks mínimos para mover TP. [1 .. 10000]
AUTO_TPSL_MIN_TP_MOVE_TICKS=1
# Ticks mínimos para mover SL. [1 .. 10000]
AUTO_TPSL_MIN_SL_MOVE_TICKS=1
# Gap de trailing = volatilidad × mult. [0.0 .. 10.0]
AUTO_TPSL_TRAIL_GAP_MULT=1.2
# Gap de trailing mínimo (fracción). [0.0 .. 0.2]
AUTO_TPSL_TRAIL_GAP_MIN=0.001
# Extensión de TP al acercarse. [1.0 .. 5.0]
AUTO_TPSL_TP_EXT_MULT=1.25
# Boost de extensión TP si ML confía. [0.0 .. 10.0]
AUTO_TPSL_ML_TP_BOOST=1.0
# Distancia relativa al TP que activa la extensión. [0.0 .. 0.2]
AUTO_TPSL_TP_PROXIMITY=0.005
# Extensión/gap mínimo del TP (fracción). [0.0 .. 0.2]
AUTO_TPSL_MIN_EXT=0.001
# Reduce el gap si ML < 0.5. [0.1 .. 1.0]
AUTO_TPSL_LOW_ML_GAP_MULT=0.85
# Cota de volatilidad usada para el gap. [0.0 .. 1.0]
AUTO_TPSL_MAX_VOLATILITY=0.25
# Tipo de orden al disparar TP/SL virtual. [Limit | Market]
AUTO_TPSL_CLOSE_ORDER_TYPE=Market

# ===== ml =====
# Filtro ML de probabilidad de acierto.
ML_ENABLED=false
# Trades finales mínimos para entrenar. [5 .. 1000000]
ML_MIN_SAMPLES=50
# Probabilidad mínima para operar. [0.5 .. 0.99]
ML_PROB_THRESHOLD=0.6
# Épocas de la regresión logística. [10 .. 100000]
ML_EPOCHS=250
# Learning rate. [1e-06 .. 10.0]
ML_LEARNING_RATE=0.15
# Regularización L2. [0.0 .. 10.0]
ML_L2=0.02

# ===== storage =====
# Directorio de datos (relativo a la raíz del proyecto).
DATA_DIR=data
# Directorio de logs/results.json.
LOGS_DIR=logs
# Ruta SQLite (vacío = DATA_DIR/trading.db).
SQLITE_PATH=
# Backend de series de alta frecuencia. [duckdb | sqlite_legacy]
STORAGE_BACKEND=duckdb
# Ruta del archivo DuckDB.
STORAGE_PATH=data/nertz.duckdb
# Flush por lotes DuckDB. [10.0 .. 5000.0]
STORAGE_BATCH_INTERVAL_MS=50.0
# Persistencia de libro cada N ms. [50.0 .. 600000.0]
ORDERBOOK_PERSIST_INTERVAL_MS=200.0
# Persistencia de ticker cada N ms. [50.0 .. 600000.0]
TICKER_PERSIST_INTERVAL_MS=200.0
# Desactiva metrics_snapshots.jsonl (por defecto sí con duckdb).
STORAGE_DISABLE_JSONL=
# Espejo SQLite de ticks/libro.
STORAGE_SQLITE_MIRROR=true
# Eventos conservados en results.json. [0 .. 1000000]
RESULTS_MAX_EVENTS=2000
# Decimales en resúmenes de results.json. [0 .. 12]
RESULTS_PRECISION=6

# ===== api =====
# Velas máximas por consulta API. [1 .. 10000]
MAX_CANDLES_API=200
# Velas de BD usadas por /discovery (soportes/resistencias). [10 .. 100000]
DISCOVERY_CANDLES_LOOKBACK=500
# Edad máxima de datos de mercado en /validation. [1.0 .. 3600.0]
VALIDATION_MARKET_MAX_AGE_S=15.0
# Host del servidor standalone.
API_HOST=0.0.0.0
# Puerto del servidor standalone. [1 .. 65535]
API_PORT=8081

# ===== general =====
# Overrides por símbolo, p.ej. {"XRPUSDT": {"MAX_TRADE_SIZE": 500, "RISK_FACTOR": 0.02}}.
SYMBOL_OVERRIDES_JSON=
# Legacy. [0 .. inf]
DEFAULT_SLEEP_TIME=10
# Legacy. [0 .. inf]
RATE_LIMIT_DELAY=50
